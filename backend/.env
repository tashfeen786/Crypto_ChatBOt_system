# APPLICATION SETTINGS
APP_NAME=Crypto RAG Chatbot
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

#API KEYS 
GROQ_API_KEY=


BINANCE_API_KEY=
BINANCE_API_SECRET=

# Get from: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# CryptoPanic API (Free - 100 requests/day)
# Get from: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Gemini AI API (Free - 1500 requests/day)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=

# Pinecone Vector Database (Free - 100K vectors)
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east1-gcp


# DATABASE SETTINGS

# PostgreSQL
# Database Connection
DATABASE_URL= 

# Redis Cache
REDIS_URL=redis://localhost:6379/0


# SECURITY 
# Secret Key for JWT and other security-related needs
SECRET_KEY=


#  PINECONE SETTINGS
PINECONE_INDEX_NAME=crypto-rag-index
PINECONE_DIMENSION=384
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# AI SETTINGS
EMBEDDING_MODEL=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1000

#  RATE LIMITS 
BINANCE_RATE_LIMIT=1200
COINGECKO_RATE_LIMIT=30
CRYPTOPANIC_RATE_LIMIT=100
GEMINI_RATE_LIMIT=1500

# CACHE TTL 
CACHE_TTL_PRICES=300
CACHE_TTL_COIN_DATA=600
CACHE_TTL_NEWS=3600

#  CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# LOGGING 
LOG_LEVEL=INFO

# DEFAULTS 
DEFAULT_USER_RISK=5
DEFAULT_TOP_COINS=50